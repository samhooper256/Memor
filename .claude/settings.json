{
  "permissions": {
    "allow": [
      "Bash(git mv *)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git rm:*)",
      "Bash(git log:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(curl:*)",
      "Bash(perl:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(ls:*)",
      "Bash(diff:*)",
      "Bash(cd:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(sqlite3:*)",
      "Bash(lsof:*)",
      "Bash(xcodebuild:*)",
      "Read(//tmp/**)",
      "Read(//private/tmp/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/allow_compound_commands.py\""
          }
        ]
      }
    ]
  }
}
